# PostgreSQL connection string.
# Local:   postgres://postgres:postgres@localhost:5432/portfolio
# Railway: copy DATABASE_URL from the Postgres service's Variables tab.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio

# Set to "false" to force SSL off, "true" to force it on. Left empty, SSL is on for any
# non-local database, which is what Railway, Neon, Render and Supabase need.
DATABASE_SSL=

# Port the API listens on. Railway and Render set this for you.
PORT=4000

# Frontend URLs allowed to call the API, comma-separated.
CORS_ORIGIN=http://localhost:3000

# Admin panel password. Change it before you deploy.
ADMIN_PASSWORD=change-me-now

# Random string used to sign admin sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
